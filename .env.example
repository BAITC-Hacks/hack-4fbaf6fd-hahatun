# OpenAI: кредиты команды с платформы HackAlem. Пустой ключ = движок работает, консилиум отвечает
# детерминированным фолбэком без LLM (в интерфейсе это помечено).
OPENAI_API_KEY=
# Дешёвая модель для 6 экспертов, средняя для синтезатора/ревизоров/арбитра.
# Пусто = gpt-5-mini и gpt-5. Список доступных: curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_EXPERT_MODEL=
OPENAI_JUDGE_MODEL=

# Куда писать прогоны (JSON-файлы). По умолчанию ./data/runs; раскомментируйте, чтобы переопределить.
# DATA_DIR=/absolute/path/to/runs
