# OpenAI (кредиты команды с платформы HackAlem). Пустой ключ = консилиум из фикстуры, движок работает.
OPENAI_API_KEY=
# Дешёвая модель для 6 экспертов и средняя для синтезатора/ревизоров/арбитра.
# ID сверить на platform.openai.com/docs/pricing перед стартом.
OPENAI_EXPERT_MODEL=
OPENAI_JUDGE_MODEL=

# SQLite файл с прогонами (папка data/ в .gitignore)
DATABASE_PATH=./data/app.db
